# Copiar a .env en el directorio de cada entorno y completar los valores reales.
# Este archivo de ejemplo no contiene credenciales y puede permanecer en Git.
POSTGRES_DB=bmpn
POSTGRES_USER=bmpn
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
BMPN_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BMPN_JWT_ACCESS_EXPIRATION=PT15M
BMPN_REFRESH_TOKEN_EXPIRATION=P5D
BMPN_REFRESH_COOKIE_SECURE=true
CORS_ORIGENES=https://REPLACE_WITH_THIS_SERVER_HOSTNAME
DATOS_INICIALES=false
DATOS_INICIALES_CLAVE=REPLACE_WITH_A_RANDOM_PASSWORD
# Referencias completas. En staging, GitHub Actions las guarda en images.env.
# BACKEND_IMAGE=ghcr.io/andrxco/bmpn:1.0.0
# FRONT_IMAGE=ghcr.io/andrxco/bmpn-react:1.0.0
HTTP_PORT=8080
