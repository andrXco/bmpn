  "item": [
    {
      "name": "01 - Empresas y autenticación",
      "item": [
        {
          "name": "01. Registrar empresa",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = Date.now();",
                  "pm.collectionVariables.set('nitEmpresa', '90' + sufijo);",
                  "pm.collectionVariables.set('correoEmpresa', 'contacto.' + sufijo + '@bmpn.local');",
                  "pm.collectionVariables.set('emailAdministrador', 'admin.' + sufijo + '@bmpn.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Empresa creada: 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye administrador inicial', () => pm.expect(body.administradorInicial.id).to.be.a('number'));",
                  "pm.collectionVariables.set('usuarioId', body.administradorInicial.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nit\": \"{{nitEmpresa}}\",\n  \"nombreEmpresa\": \"Empresa Postman\",\n  \"correoContacto\": \"{{correoEmpresa}}\",\n  \"nombreAdministrador\": \"Ana\",\n  \"apellidoAdministrador\": \"Prueba\",\n  \"emailAdministrador\": \"{{emailAdministrador}}\",\n  \"password\": \"ClaveSegura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/empresas"
          }
        },
        {
          "name": "02. Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Inicio de sesión correcto: 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye usuarioId', () => pm.expect(body.usuarioId).to.be.a('number'));",
                  "pm.collectionVariables.set('usuarioId', body.usuarioId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdministrador}}\",\n  \"password\": \"ClaveSegura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/sesiones"
          }
        }
      ]
